# Windows cross build environment (MinGW-w64) on Debian 12
#
# MinGW GCC 14.2 with mingw-w64 13.0.0, built from source in the first stage (the Debian 12
# packages, GCC 12.2 with mingw-w64 10.0.0, corrupt the heap when a thread with thread_local
# objects ends). Posix thread model, msvcrt runtime, Qt 5.15.3 (with Charts) built from source,
# OpenSceneGraph 3.6, osgEarth 3.8 and the other COMPASS and jASTERIX dependencies
# built from source (DuckDB as official binary).
# All Windows libraries are installed into /opt/win64.
# The resulting executables run on Windows or in Wine.

# ---------------------------------------------------------------------------------------------
# stage 1: MinGW-w64 cross toolchain in /opt/mingw
# ---------------------------------------------------------------------------------------------

FROM debian:12 AS mingw

ARG BINUTILS_VERSION=2.43
ARG MINGW_VERSION=13.0.0
ARG GCC_VERSION=14.2.0
ARG TARGET=x86_64-w64-mingw32
ARG PREFIX=/opt/mingw

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
     build-essential ca-certificates wget bzip2 xz-utils file texinfo \
     libgmp-dev libmpfr-dev libmpc-dev libisl-dev zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*

ENV PATH=${PREFIX}/bin:${PATH}

WORKDIR /build

RUN wget -q https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.xz \
  && wget -q https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz \
  && wget -q https://downloads.sourceforge.net/project/mingw-w64/mingw-w64/mingw-w64-release/mingw-w64-v${MINGW_VERSION}.tar.bz2 \
  && tar xf binutils-${BINUTILS_VERSION}.tar.xz && tar xf gcc-${GCC_VERSION}.tar.xz \
  && tar xf mingw-w64-v${MINGW_VERSION}.tar.bz2 && rm *.tar.*

# binutils
RUN mkdir b-binutils && cd b-binutils \
  && ../binutils-${BINUTILS_VERSION}/configure --target=${TARGET} --prefix=${PREFIX} \
       --disable-multilib --disable-nls --disable-werror \
  && make -j$(nproc) && make install

# mingw-w64 headers
RUN mkdir b-headers && cd b-headers \
  && ../mingw-w64-v${MINGW_VERSION}/mingw-w64-headers/configure --host=${TARGET} \
       --prefix=${PREFIX}/${TARGET} --with-default-msvcrt=msvcrt \
  && make install

# GCC stage 1: compiler only
RUN mkdir b-gcc && cd b-gcc \
  && ../gcc-${GCC_VERSION}/configure --target=${TARGET} --prefix=${PREFIX} \
       --enable-languages=c,c++ --enable-threads=posix --disable-multilib --disable-nls \
       --enable-shared --enable-static --with-system-zlib \
  && make -j$(nproc) all-gcc && make install-gcc

# mingw-w64 runtime (64 bit only)
RUN mkdir b-crt && cd b-crt \
  && ../mingw-w64-v${MINGW_VERSION}/mingw-w64-crt/configure --host=${TARGET} \
       --prefix=${PREFIX}/${TARGET} --disable-lib32 --enable-lib64 --with-default-msvcrt=msvcrt \
  && make -j$(nproc) && make install

# winpthreads
RUN mkdir b-winpthreads && cd b-winpthreads \
  && ../mingw-w64-v${MINGW_VERSION}/mingw-w64-libraries/winpthreads/configure --host=${TARGET} \
       --prefix=${PREFIX}/${TARGET} --enable-shared --enable-static \
  && make -j$(nproc) && make install

# GCC stage 2: libgcc, libstdc++
RUN cd b-gcc && make -j$(nproc) && make install

# ---------------------------------------------------------------------------------------------
# stage 2: Windows libraries
# ---------------------------------------------------------------------------------------------

FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     mingw-w64-tools \
     libisl23 \
     libmpc3 \
     libmpfr6 \
     libgmp10 \
     zlib1g \
     cmake \
     ninja-build \
     make \
     pkg-config \
     python3 \
     python3-venv \
     ca-certificates \
     p7zip-full \
     git \
     wget \
     unzip \
     xz-utils \
     bzip2 \
     sqlite3 \
     perl \
     qtbase5-dev-tools \
  && rm -rf /var/lib/apt/lists/*

# toolchain from stage 1, the -posix names as in the Debian packages (thread model posix)
COPY --from=mingw /opt/mingw /opt/mingw
ENV PATH=/opt/mingw/bin:${PATH}
RUN ln -s x86_64-w64-mingw32-gcc /opt/mingw/bin/x86_64-w64-mingw32-gcc-posix \
  && ln -s x86_64-w64-mingw32-g++ /opt/mingw/bin/x86_64-w64-mingw32-g++-posix

RUN x86_64-w64-mingw32-g++-posix --version && /usr/lib/qt5/bin/moc -v

# prebuilt Qt 5.15.2 for MinGW 64 bit: no longer used, QT_WIN_DIR is set to the own Qt 5.15.3
# build at the end of this file. Kept only so that the layers below stay in the build cache,
# remove at the next full image rebuild.
RUN python3 -m venv /opt/aqt \
  && /opt/aqt/bin/pip install --no-cache-dir aqtinstall \
  && /opt/aqt/bin/aqt install-qt windows desktop 5.15.2 win64_mingw81 -m qtcharts -O /opt/qt \
  && test -f /opt/qt/5.15.2/mingw81_64/lib/cmake/Qt5Widgets/Qt5WidgetsConfig.cmake \
  && test -f /opt/qt/5.15.2/mingw81_64/lib/cmake/Qt5Charts/Qt5ChartsConfig.cmake

ENV QT_WIN_DIR=/opt/qt/5.15.2/mingw81_64
ENV MINGW_GCC_DLL_DIR=/opt/mingw/x86_64-w64-mingw32/lib
ENV MINGW_SYS_DLL_DIR=/opt/mingw/x86_64-w64-mingw32/bin
ENV WIN64_PREFIX=/opt/win64

# only Windows pkg-config files, never the ones of the Linux host
ENV PKG_CONFIG_LIBDIR=/opt/win64/lib/pkgconfig:/opt/win64/share/pkgconfig

COPY mingw_toolchain.cmake /opt/mingw_toolchain.cmake

ARG WIN_CMAKE="-G Ninja -DCMAKE_TOOLCHAIN_FILE=/opt/mingw_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/win64"

WORKDIR /build

# zlib
RUN wget -q https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz \
  && tar xzf zlib-1.3.1.tar.gz \
  && cmake ${WIN_CMAKE} -S zlib-1.3.1 -B zlib-build \
  && cmake --build zlib-build && cmake --install zlib-build \
  && rm -rf zlib-*

# libpng
RUN wget -q https://download.sourceforge.net/libpng/libpng-1.6.43.tar.xz \
  && tar xJf libpng-1.6.43.tar.xz \
  && cmake ${WIN_CMAKE} -DPNG_TESTS=OFF -DPNG_STATIC=OFF -DPNG_EXECUTABLES=OFF -S libpng-1.6.43 -B png-build \
  && cmake --build png-build && cmake --install png-build \
  && rm -rf libpng-* png-build

# libjpeg-turbo (no SIMD, avoids nasm)
RUN wget -q https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.0.3/libjpeg-turbo-3.0.3.tar.gz \
  && tar xzf libjpeg-turbo-3.0.3.tar.gz \
  && cmake ${WIN_CMAKE} -DWITH_SIMD=OFF -DENABLE_STATIC=OFF -S libjpeg-turbo-3.0.3 -B jpeg-build \
  && cmake --build jpeg-build && cmake --install jpeg-build \
  && rm -rf libjpeg-turbo-* jpeg-build

# freetype
RUN wget -q https://download.savannah.gnu.org/releases/freetype/freetype-2.13.2.tar.xz \
  && tar xJf freetype-2.13.2.tar.xz \
  && cmake ${WIN_CMAKE} -DBUILD_SHARED_LIBS=ON -DFT_DISABLE_HARFBUZZ=ON -DFT_DISABLE_BROTLI=ON \
     -DFT_DISABLE_BZIP2=ON -DFT_DISABLE_PNG=ON -S freetype-2.13.2 -B freetype-build \
  && cmake --build freetype-build && cmake --install freetype-build \
  && rm -rf freetype-*

# sqlite (amalgamation, built as DLL)
RUN wget -q https://www.sqlite.org/2024/sqlite-amalgamation-3460100.zip \
  && unzip -q sqlite-amalgamation-3460100.zip \
  && cd sqlite-amalgamation-3460100 \
  && x86_64-w64-mingw32-gcc-posix -O2 -shared -DSQLITE_ENABLE_RTREE=1 -DSQLITE_ENABLE_COLUMN_METADATA=1 \
     -DSQLITE_API="__declspec(dllexport)" sqlite3.c -o libsqlite3.dll -Wl,--out-implib,libsqlite3.dll.a \
  && mkdir -p /opt/win64/bin /opt/win64/lib /opt/win64/include \
  && cp libsqlite3.dll /opt/win64/bin/ && cp libsqlite3.dll.a /opt/win64/lib/ \
  && cp sqlite3.h sqlite3ext.h /opt/win64/include/ \
  && cd .. && rm -rf sqlite-amalgamation-*

# curl (Windows native TLS via Schannel)
RUN wget -q https://curl.se/download/curl-8.10.1.tar.xz \
  && tar xJf curl-8.10.1.tar.xz \
  && cmake ${WIN_CMAKE} -DBUILD_SHARED_LIBS=ON -DBUILD_CURL_EXE=OFF -DBUILD_TESTING=OFF -DCURL_USE_SCHANNEL=ON \
     -DCURL_USE_OPENSSL=OFF -DCURL_USE_LIBPSL=OFF -DCURL_USE_LIBSSH2=OFF -DUSE_NGHTTP2=OFF -DUSE_LIBIDN2=OFF \
     -DCURL_ZSTD=OFF -DCURL_BROTLI=OFF -DENABLE_CURL_MANUAL=OFF -DBUILD_LIBCURL_DOCS=OFF -DBUILD_MISC_DOCS=OFF \
     -S curl-8.10.1 -B curl-build \
  && cmake --build curl-build && cmake --install curl-build \
  && rm -rf curl-*

# GEOS
RUN wget -q https://download.osgeo.org/geos/geos-3.12.2.tar.bz2 \
  && tar xjf geos-3.12.2.tar.bz2 \
  && cmake ${WIN_CMAKE} -DBUILD_TESTING=OFF -DBUILD_BENCHMARKS=OFF -DBUILD_DOCUMENTATION=OFF -S geos-3.12.2 -B geos-build \
  && cmake --build geos-build && cmake --install geos-build \
  && rm -rf geos-*

# PROJ (proj.db is generated with the host sqlite3)
RUN wget -q https://download.osgeo.org/proj/proj-9.4.1.tar.gz \
  && tar xzf proj-9.4.1.tar.gz \
  && cmake ${WIN_CMAKE} -DBUILD_TESTING=OFF -DBUILD_APPS=OFF -DENABLE_TIFF=OFF -DENABLE_CURL=OFF \
     -DEXE_SQLITE3=/usr/bin/sqlite3 -DSQLite3_INCLUDE_DIR=/opt/win64/include -DSQLite3_LIBRARY=/opt/win64/lib/libsqlite3.dll.a \
     -S proj-9.4.1 -B proj-build \
  && cmake --build proj-build && cmake --install proj-build \
  && rm -rf proj-*

# Expat (GDAL needs it to read KML and GML, e.g. for the sector import)
RUN wget -q https://github.com/libexpat/libexpat/releases/download/R_2_6_3/expat-2.6.3.tar.xz \
  && tar xJf expat-2.6.3.tar.xz \
  && cmake ${WIN_CMAKE} -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_EXAMPLES=OFF -DEXPAT_BUILD_TESTS=OFF \
     -DEXPAT_BUILD_DOCS=OFF -DEXPAT_SHARED_LIBS=ON -S expat-2.6.3 -B expat-build \
  && cmake --build expat-build && cmake --install expat-build \
  && rm -rf expat-*

# GDAL (internal tiff, geotiff, png, jpeg, zlib, json-c, only the listed external libraries)
RUN wget -q https://github.com/OSGeo/gdal/releases/download/v3.9.3/gdal-3.9.3.tar.gz \
  && tar xzf gdal-3.9.3.tar.gz \
  && cmake ${WIN_CMAKE} -DBUILD_TESTING=OFF -DBUILD_APPS=OFF -DBUILD_PYTHON_BINDINGS=OFF -DBUILD_JAVA_BINDINGS=OFF \
     -DBUILD_CSHARP_BINDINGS=OFF -DGDAL_USE_EXTERNAL_LIBS=OFF -DGDAL_USE_SQLITE3=ON -DGDAL_USE_CURL=ON -DGDAL_USE_GEOS=ON \
     -DGDAL_USE_EXPAT=ON \
     -DSQLite3_INCLUDE_DIR=/opt/win64/include -DSQLite3_LIBRARY=/opt/win64/lib/libsqlite3.dll.a \
     -S gdal-3.9.3 -B gdal-build \
  && cmake --build gdal-build && cmake --install gdal-build \
  && rm -rf gdal-*

# OpenGL core profile headers (needed by OSG with OPENGL_PROFILE=GLCORE on Windows)
RUN mkdir -p /opt/win64/include/GL /opt/win64/include/KHR \
  && wget -q -O /opt/win64/include/GL/glcorearb.h https://registry.khronos.org/OpenGL/api/GL/glcorearb.h \
  && wget -q -O /opt/win64/include/KHR/khrplatform.h https://registry.khronos.org/EGL/api/KHR/khrplatform.h

# OpenSceneGraph 3.6 branch, same GL options as the Linux build
RUN git clone --branch OpenSceneGraph-3.6 --depth 1 https://github.com/openscenegraph/OpenSceneGraph.git OpenSceneGraph-3.6 \
  && git -C OpenSceneGraph-3.6 rev-parse HEAD > /opt/win64/osg_commit.txt \
  && cmake ${WIN_CMAKE} \
    -DBUILD_SHARED_LIBS=ON \
    -DCURL_IS_STATIC=OFF \
    -DCURL_LIBRARY=$(ls /opt/win64/lib/libcurl*.a | head -1) \
    -DCURL_INCLUDE_DIR=/opt/win64/include \
    -DGLCORE_ROOT=/opt/win64/include \
    -DOSG_DETERMINE_WIN_VERSION=OFF \
    -DCMAKE_CXX_FLAGS="-D_WIN32_WINNT=0x0A00 -DGL_COMPRESSED_SRGB_S3TC_DXT1_EXT=0x8C4C -DGL_COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT=0x8C4D -DGL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT=0x8C4E -DGL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT=0x8C4F" \
    -DOPENGL_PROFILE=GLCORE \
    -DOSG_GLU_AVAILABLE=OFF \
    -DOSG_GL1_AVAILABLE=OFF \
    -DOSG_GL2_AVAILABLE=OFF \
    -DOSG_GL3_AVAILABLE=ON \
    -DOSG_GLES1_AVAILABLE=OFF \
    -DOSG_GLES2_AVAILABLE=OFF \
    -DOSG_GL_DISPLAYLISTS_AVAILABLE=OFF \
    -DOSG_GL_MATRICES_AVAILABLE=OFF \
    -DOSG_GL_VERTEX_FUNCS_AVAILABLE=OFF \
    -DOSG_GL_VERTEX_ARRAY_FUNCS_AVAILABLE=OFF \
    -DOSG_GL_FIXED_FUNCTION_AVAILABLE=OFF \
    -D_OPENTHREADS_ATOMIC_USE_GCC_BUILTINS=0 \
    -D_OPENTHREADS_ATOMIC_USE_MIPOSPRO_BUILTINS=0 \
    -D_OPENTHREADS_ATOMIC_USE_SUN=0 \
    -D_OPENTHREADS_ATOMIC_USE_WIN32_INTERLOCKED=1 \
    -D_OPENTHREADS_ATOMIC_USE_BSD_ATOMIC=0 \
    -S OpenSceneGraph-3.6 -B osg-build \
  && cmake --build osg-build && cmake --install osg-build \
  && rm -rf OpenSceneGraph-3.6 osg-build

# mixed-case Windows header names used by MSVC code (Linux file systems are case-sensitive)
RUN cd /opt/mingw/x86_64-w64-mingw32/include \
  && ln -s windows.h Windows.h \
  && ln -s wininet.h WinInet.h \
  && ln -s shobjidl.h ShObjIdl.h

# osgEarth 3.8 (tag), the world.tif test image is kept for tests
RUN git clone --branch osgearth-3.8 --depth 1 --recurse-submodules https://github.com/gwaldron/osgearth.git osgearth-3.8 \
  && git -C osgearth-3.8 rev-parse HEAD > /opt/win64/osgearth_commit.txt \
  && mkdir -p /opt/win64/share/osgearth_test_data && cp osgearth-3.8/data/world.tif /opt/win64/share/osgearth_test_data/ \
  && cmake ${WIN_CMAKE} -DOSGEARTH_BUILD_TESTS=OFF -DOSGEARTH_BUILD_EXAMPLES=OFF -DOSGEARTH_BUILD_DOCS=OFF \
     -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_LIBDIR=lib \
     -DCMAKE_CXX_FLAGS="-DWIN32 -D_WIN32_WINNT=0x0A00" -DCMAKE_C_FLAGS="-DWIN32 -D_WIN32_WINNT=0x0A00" \
     -DCMAKE_CXX_STANDARD_LIBRARIES="-lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -ldbghelp" \
     -DSQLite3_INCLUDE_DIR=/opt/win64/include -DSQLite3_LIBRARY=/opt/win64/lib/libsqlite3.dll.a \
     -S osgearth-3.8 -B osgearth-build \
  && cmake --build osgearth-build && cmake --install osgearth-build \
  && rm -rf osgearth-3.8 osgearth-build

# Qt5 host tools (moc, uic, rcc) for the cross build
COPY qt5_host_tools.cmake /opt/qt5_host_tools.cmake

### remaining COMPASS and jASTERIX dependencies

# bzip2 (static, for libarchive and Boost.Iostreams)
RUN wget -q https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz \
  && tar xzf bzip2-1.0.8.tar.gz \
  && cd bzip2-1.0.8 \
  && for f in blocksort huffman crctable randtable compress decompress bzlib; do \
       x86_64-w64-mingw32-gcc-posix -O2 -D_FILE_OFFSET_BITS=64 -c $f.c || exit 1; done \
  && x86_64-w64-mingw32-ar rcs libbz2.a *.o \
  && cp libbz2.a /opt/win64/lib/ && cp bzlib.h /opt/win64/include/ \
  && cd .. && rm -rf bzip2-1.0.8*

# xz / liblzma (for libarchive)
RUN wget -q https://github.com/tukaani-project/xz/releases/download/v5.6.3/xz-5.6.3.tar.gz \
  && tar xzf xz-5.6.3.tar.gz \
  && cmake ${WIN_CMAKE} -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -S xz-5.6.3 -B xz-build \
  && cmake --build xz-build && cmake --install xz-build \
  && rm -rf xz-*

# libarchive (gzip, bzip2, xz, zip)
RUN wget -q https://github.com/libarchive/libarchive/releases/download/v3.7.7/libarchive-3.7.7.tar.gz \
  && tar xzf libarchive-3.7.7.tar.gz \
  && cmake ${WIN_CMAKE} -DENABLE_TEST=OFF -DENABLE_TAR=OFF -DENABLE_CPIO=OFF -DENABLE_CAT=OFF -DENABLE_UNZIP=OFF \
     -DENABLE_OPENSSL=OFF -DENABLE_MBEDTLS=OFF -DENABLE_NETTLE=OFF -DENABLE_LIBB2=OFF -DENABLE_LZ4=OFF -DENABLE_ZSTD=OFF \
     -DENABLE_LIBXML2=OFF -DENABLE_EXPAT=OFF -DENABLE_PCREPOSIX=OFF -DENABLE_PCRE2POSIX=OFF -DENABLE_ICONV=OFF \
     -DENABLE_ACL=OFF -DENABLE_XATTR=OFF -DENABLE_LZMA=ON -DENABLE_BZip2=ON -DENABLE_ZLIB=ON \
     -DBZIP2_INCLUDE_DIR=/opt/win64/include -DBZIP2_LIBRARY_RELEASE=/opt/win64/lib/libbz2.a \
     -S libarchive-3.7.7 -B libarchive-build \
  && cmake --build libarchive-build && cmake --install libarchive-build \
  && rm -rf libarchive-*

# OpenSSL 3.0 LTS
RUN wget -q https://github.com/openssl/openssl/releases/download/openssl-3.0.15/openssl-3.0.15.tar.gz \
  && tar xzf openssl-3.0.15.tar.gz \
  && cd openssl-3.0.15 \
  && ./Configure mingw64 shared no-tests --cross-compile-prefix=x86_64-w64-mingw32- --prefix=/opt/win64 --libdir=lib \
  && make -j$(nproc) && make install_sw \
  && cd .. && rm -rf openssl-*

# libbacktrace (for boost_stacktrace_backtrace, as in the Alma8 build)
RUN git clone --depth 1 https://github.com/ianlancetaylor/libbacktrace.git \
  && cd libbacktrace \
  && ./configure --host=x86_64-w64-mingw32 --prefix=/opt/win64 --enable-shared=no CC=x86_64-w64-mingw32-gcc-posix \
  && make -j$(nproc) && make install \
  && cd .. && rm -rf libbacktrace

# Linux host compiler, needed to build the Boost build engine b2
RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ \
  && rm -rf /var/lib/apt/lists/*

# Boost 1.83, same version as the Linux build
RUN wget -q -O boost_1_83_0.tar.gz https://sourceforge.net/projects/boost/files/boost/1.83.0/boost_1_83_0.tar.gz/download \
  && tar xzf boost_1_83_0.tar.gz \
  && cd boost_1_83_0 \
  && ./bootstrap.sh \
  && echo "using gcc : mingw : x86_64-w64-mingw32-g++-posix ;" > user-config.jam \
  && ./b2 --user-config=user-config.jam toolset=gcc-mingw target-os=windows threadapi=win32 \
     address-model=64 architecture=x86 variant=release link=shared runtime-link=shared threading=multi \
     --layout=system --prefix=/opt/win64 -j$(nproc) \
     --with-regex --with-program_options --with-filesystem --with-iostreams --with-thread \
     --with-stacktrace --with-date_time --with-system \
     -sZLIB_INCLUDE=/opt/win64/include -sZLIB_LIBRARY_PATH=/opt/win64/lib -sZLIB_NAME=zlib \
     -sBZIP2_INCLUDE=/opt/win64/include -sBZIP2_LIBRARY_PATH=/opt/win64/lib \
     -sNO_LZMA=1 -sNO_ZSTD=1 -sLIBBACKTRACE_PATH=/opt/win64 \
     cxxflags="-std=c++17" install \
  && echo "b2 checks libbacktrace by running a test exe, which fails in a cross build: build the library directly" \
  && x86_64-w64-mingw32-g++-posix -std=c++17 -O2 -shared \
     -DBOOST_STACKTRACE_INTERNAL_BUILD_LIBS=1 -DBOOST_STACKTRACE_LINK=1 -DBOOST_STACKTRACE_DYN_LINK=1 \
     -I/opt/win64/include libs/stacktrace/src/backtrace.cpp -L/opt/win64/lib -lbacktrace \
     -o /opt/win64/lib/libboost_stacktrace_backtrace.dll -Wl,--out-implib,/opt/win64/lib/libboost_stacktrace_backtrace.dll.a \
  && cd /opt/win64/lib/cmake \
  && cp -r boost_stacktrace_basic-1.83.0 boost_stacktrace_backtrace-1.83.0 \
  && cd boost_stacktrace_backtrace-1.83.0 \
  && for f in *stacktrace_basic*; do sed -i 's/stacktrace_basic/stacktrace_backtrace/g' "$f"; \
       mv "$f" "$(echo "$f" | sed 's/stacktrace_basic/stacktrace_backtrace/')"; done \
  && cd /build && rm -rf boost_1_83_0* \
  && test -f /opt/win64/lib/libboost_stacktrace_backtrace.dll.a \
  && cp /opt/win64/lib/libboost_*.dll /opt/win64/bin/

# oneTBB, same version as the Alma8 build
# MinGW GCC 12 crashes (ICE in seh_emit_stackalloc) with -fstack-clash-protection, which oneTBB
# always adds for GCC. A compiler launcher removes only this flag, LTO is off for the same reason.
RUN printf '#!/bin/bash\nargs=()\nfor a in "$@"; do [[ "$a" == -fstack-clash-protection ]] || args+=("$a"); done\nexec "${args[@]}"\n' \
     > /opt/no_stack_clash_launcher.sh && chmod +x /opt/no_stack_clash_launcher.sh \
  && git clone --branch v2021.13.0 --depth 1 https://github.com/uxlfoundation/oneTBB.git oneTBB \
  && cmake ${WIN_CMAKE} -DTBB_TEST=OFF -DTBB_STRICT=OFF -DTBB_EXAMPLES=OFF \
     -DTBBMALLOC_PROXY_BUILD=OFF -DTBB_ENABLE_IPO=OFF \
     -DCMAKE_CXX_COMPILER_LAUNCHER=/opt/no_stack_clash_launcher.sh \
     -DCMAKE_C_STANDARD_LIBRARIES="-lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -lssp" \
     -DCMAKE_CXX_STANDARD_LIBRARIES="-lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -lssp" \
     -S oneTBB -B tbb-build \
  && cmake --build tbb-build && cmake --install tbb-build \
  && rm -rf oneTBB tbb-build

# log4cpp (static library)
# log4cpp/config-MinGW32.h defines int64_t as a macro unless LOG4CPP_HAVE_INT64_T is set, which
# breaks <cstdint>. The same block has the in_addr_t typedef. Users of the headers (COMPASS,
# jASTERIX) must also define LOG4CPP_HAVE_INT64_T.
RUN wget -q -O log4cpp-1.1.4.tar.gz "https://sourceforge.net/projects/log4cpp/files/log4cpp-1.1.x%20%28new%29/log4cpp-1.1/log4cpp-1.1.4.tar.gz/download" \
  && tar xzf log4cpp-1.1.4.tar.gz \
  && cmake ${WIN_CMAKE} -DCMAKE_CXX_FLAGS="-DLOG4CPP_HAVE_INT64_T -Din_addr_t=u_long" -S log4cpp -B log4cpp-build \
  && cmake --build log4cpp-build && cmake --install log4cpp-build \
  && rm -rf log4cpp*

# Eigen3 (headers only)
RUN wget -q https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz \
  && tar xzf eigen-3.4.0.tar.gz \
  && cmake ${WIN_CMAKE} -DBUILD_TESTING=OFF -DEIGEN_BUILD_DOC=OFF -DEIGEN_BUILD_PKGCONFIG=OFF -S eigen-3.4.0 -B eigen-build \
  && cmake --install eigen-build \
  && rm -rf eigen-*

# GeographicLib 1.52 (1.x API as the Linux distribution packages)
RUN wget -q -O GeographicLib-1.52.tar.gz https://sourceforge.net/projects/geographiclib/files/distrib/GeographicLib-1.52.tar.gz/download \
  && tar xzf GeographicLib-1.52.tar.gz \
  && cmake ${WIN_CMAKE} -DGEOGRAPHICLIB_LIB_TYPE=SHARED -DGEOGRAPHICLIB_DOCUMENTATION=OFF -S GeographicLib-1.52 -B geographiclib-build \
  && cmake --build geographiclib-build && cmake --install geographiclib-build \
  && rm -rf GeographicLib-* geographiclib-build

# NemaTode (bump NEMATODE_REV when hpuhr/NemaTode master changes, as in the Linux build)
ARG NEMATODE_REV=11650f3
RUN wget -q -O nematode.zip https://github.com/hpuhr/NemaTode/archive/refs/heads/master.zip \
  && unzip -q nematode.zip \
  && cmake ${WIN_CMAKE} -S NemaTode-master -B nematode-build -DBUILD_SHARED_LIBS=ON \
  && cmake --build nematode-build && cmake --install nematode-build \
  && rm -rf nematode.zip NemaTode-master nematode-build \
  && echo "NemaTode installs its config directly into lib/cmake, find_package searches lib/cmake/<name>*/" \
  && mkdir -p /opt/win64/lib/cmake/NemaTode \
  && echo 'include(${CMAKE_CURRENT_LIST_DIR}/../NemaTodeConfig.cmake)' > /opt/win64/lib/cmake/NemaTode/NemaTodeConfig.cmake

# DuckDB 1.5.5 (official Windows DLL, C API), GNU ld links the MSVC import library duckdb.lib directly
# (gendef does not finish on this DLL)
RUN wget -q https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-windows-amd64.zip \
  && mkdir duckdb && unzip -q libduckdb-windows-amd64.zip -d duckdb \
  && cp duckdb/duckdb.h /opt/win64/include/ && cp duckdb/duckdb.dll /opt/win64/bin/ \
  && cp duckdb/duckdb.lib /opt/win64/lib/ \
  && rm -rf duckdb libduckdb-windows-amd64.zip

# CMake 3.28 (as in the Linux build), jASTERIX and COMPASS need 3.28, Debian 12 has 3.25.
# Installed last, the dependencies above are built with the Debian CMake.
ENV CMAKE_VERSION=3.28.1
RUN wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz \
  && tar xzf cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz -C /opt \
  && ln -s /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/* /usr/local/bin/ \
  && rm cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz \
  && cmake --version

# libpcap 1.10.5 for reading PCAP files only (PCAP_TYPE null): COMPASS and jASTERIX do not
# capture from network interfaces, so no Npcap driver or Npcap DLLs are needed.
# pcap.dll, no conflict with an installed Npcap wpcap.dll. flex and bison: filter grammar.
RUN apt-get update && apt-get install -y --no-install-recommends flex bison \
  && rm -rf /var/lib/apt/lists/* \
  && wget -q https://www.tcpdump.org/release/libpcap-1.10.5.tar.xz \
  && tar xf libpcap-1.10.5.tar.xz \
  && cmake ${WIN_CMAKE} -DPCAP_TYPE=null -DENABLE_REMOTE=OFF -DDISABLE_DPDK=ON \
     -DDISABLE_RDMA=ON -DDISABLE_DBUS=ON -DDISABLE_BLUETOOTH=ON -DDISABLE_USB=ON \
     -DBUILD_WITH_LIBNL=OFF -S libpcap-1.10.5 -B libpcap-build \
  && cmake --build libpcap-build \
  && cmake --install libpcap-build \
  && rm -rf libpcap-1.10.5.tar.xz libpcap-1.10.5 libpcap-build

# Qt 5.15.3 (as in the Alma8 build), built with the toolchain of stage 1. The prebuilt Qt 5.15.2
# (MinGW 8.1) runs with the runtime DLLs of this toolchain and crashed at about 1 in 130 starts
# in the QApplication constructor (QWindowsContextPrivate), also in a minimal Qt program.
# qtbase with desktop OpenGL and the bundled third-party libraries, plus qtsvg, qtimageformats
# and qtcharts. Debug information in separate files (lib/*.dll.debug, plugins/*/*.dll.debug).
# GCC 11 and later: some headers need <limits> and <cstdint> (fixed in later Qt 5.15 versions).
# The Linux host tools (qmake, moc, uic, rcc) are in /opt/qt/5.15.3/mingw_64/bin.
ARG QT_VERSION=5.15.3
ARG QT_URL=https://download.qt.io/archive/qt/5.15/${QT_VERSION}/submodules
RUN for m in qtbase qtsvg qtimageformats qtcharts; do \
       wget -q ${QT_URL}/$m-everywhere-opensource-src-${QT_VERSION}.tar.xz \
       && tar xf $m-everywhere-opensource-src-${QT_VERSION}.tar.xz || exit 1; done \
  && for f in src/corelib/text/qbytearraymatcher.h src/corelib/tools/qoffsetstringarray_p.h \
              src/corelib/global/qfloat16.h src/corelib/global/qendian.h; do \
       sed -i '0,/^#include/s//#include <limits>\n#include <cstdint>\n#include/' \
           qtbase-everywhere-src-${QT_VERSION}/$f || exit 1; done \
  && mkdir qtbase-build && cd qtbase-build \
  && ../qtbase-everywhere-src-${QT_VERSION}/configure -xplatform win32-g++ \
       -device-option CROSS_COMPILE=x86_64-w64-mingw32- -prefix /opt/qt/${QT_VERSION}/mingw_64 \
       -opensource -confirm-license -release -shared -force-debug-info -separate-debug-info \
       -opengl desktop -nomake examples -nomake tests -no-pkg-config \
       -qt-zlib -qt-libpng -qt-libjpeg -qt-freetype -qt-harfbuzz -qt-pcre \
       -no-icu -no-dbus -no-openssl -no-fontconfig \
  && make -j$(nproc) && make install \
  && cd /build \
  && for m in qtsvg qtimageformats qtcharts; do \
       mkdir $m-build && cd $m-build \
       && /opt/qt/${QT_VERSION}/mingw_64/bin/qmake ../$m-everywhere-src-${QT_VERSION} \
       && make -j$(nproc) && make install && cd /build || exit 1; done \
  && rm -rf qt*-everywhere-* qt*-build \
  && test -f /opt/qt/${QT_VERSION}/mingw_64/lib/cmake/Qt5Widgets/Qt5WidgetsConfig.cmake \
  && test -f /opt/qt/${QT_VERSION}/mingw_64/lib/cmake/Qt5Charts/Qt5ChartsConfig.cmake \
  && test -f /opt/qt/${QT_VERSION}/mingw_64/plugins/platforms/qwindows.dll

ENV QT_WIN_DIR=/opt/qt/5.15.3/mingw_64

WORKDIR /
